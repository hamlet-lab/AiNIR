{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ainir.dev/schemas/evidence_provider_policy.schema.json",
  "title": "AiNIR EvidenceProviderPolicy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "policy_id",
    "policy_sha256",
    "provider_id",
    "allowed_provider_versions",
    "allowed_source_kinds",
    "allowed_issuer_ids",
    "allowed_issuer_kinds",
    "allowed_evidence_kinds",
    "allowed_producer_kinds",
    "allowed_signature_key_ids",
    "minimum_reliability",
    "require_subject_binding",
    "require_validity_window",
    "require_active_revocation",
    "max_revocation_age_seconds",
    "require_verified_signature",
    "allow_trust_gate_promotion",
    "production_runtime_ready"
  ],
  "properties": {
    "kind": {
      "const": "AiNIREvidenceProviderPolicy"
    },
    "version": {
      "const": "ainir.evidence-provider-policy.v1"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:@/-]{1,160}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "provider_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:@/-]{1,160}$"
    },
    "allowed_provider_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:@/-]{1,160}$"
      }
    },
    "allowed_source_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "fixture",
          "file",
          "signed_bundle"
        ]
      }
    },
    "allowed_issuer_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:@/-]{1,160}$"
      }
    },
    "allowed_issuer_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:@/-]{1,160}$"
      }
    },
    "allowed_evidence_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:@/-]{1,160}$"
      }
    },
    "allowed_producer_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:@/-]{1,160}$"
      }
    },
    "minimum_reliability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "require_subject_binding": {
      "type": "boolean"
    },
    "require_validity_window": {
      "type": "boolean"
    },
    "require_active_revocation": {
      "type": "boolean"
    },
    "max_revocation_age_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31536000
    },
    "require_verified_signature": {
      "type": "boolean"
    },
    "allow_trust_gate_promotion": {
      "const": false
    },
    "production_runtime_ready": {
      "const": false
    },
    "allowed_signature_key_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:@/-]{1,160}$"
      }
    }
  }
}
