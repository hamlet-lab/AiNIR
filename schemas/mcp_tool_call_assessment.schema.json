{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ainir.dev/schemas/mcp_tool_call_assessment.schema.json",
  "title": "AiNIR MCP Tool-Call Assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "assessment_id",
    "assessment_sha256",
    "overall_status",
    "host_handoff_allowed",
    "execution_performed",
    "profile_id",
    "profile_sha256",
    "envelope_id",
    "envelope_sha256",
    "context_id",
    "context_sha256",
    "tool_name",
    "risk_class",
    "effects",
    "capabilities",
    "checks",
    "required_host_actions",
    "production_runtime_ready"
  ],
  "properties": {
    "kind": {
      "const": "AiNIRMCPToolCallAssessment"
    },
    "version": {
      "const": "ainir.mcp-tool-call-assessment.v1"
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^ainir\\.mcp\\.assessment\\.[0-9a-f]{20}$"
    },
    "assessment_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "overall_status": {
      "enum": [
        "passed",
        "refused",
        "invalid",
        "review_required"
      ]
    },
    "host_handoff_allowed": {
      "type": "boolean"
    },
    "execution_performed": {
      "const": false
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "envelope_id": {
      "type": "string",
      "pattern": "^ainir\\.mcp\\.envelope\\.[0-9a-f]{20}$"
    },
    "envelope_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "context_id": {
      "type": "string",
      "pattern": "^ainir\\.mcp\\.context\\.[0-9a-f]{20}$"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tool_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "risk_class": {
      "anyOf": [
        {
          "enum": [
            "read_only",
            "state_change",
            "destructive",
            "network",
            "credential_sensitive",
            "financial",
            "account_change"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "effects": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 0,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:@/+\\-]{1,200}$"
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 0,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:@/+\\-]{1,200}$"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "status",
          "expected",
          "actual"
        ],
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed"
            ]
          },
          "expected": {},
          "actual": {}
        }
      }
    },
    "required_host_actions": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "enum": [
          "do_not_execute",
          "execute_outside_ainir_core",
          "obtain_final_destructive_action_confirmation",
          "preserve_assessment_for_audit",
          "reassess_after_final_confirmation",
          "resolve_resource_identity_and_scope_at_execution",
          "revalidate_authorization_at_execution",
          "review_failed_checks"
        ]
      }
    },
    "production_runtime_ready": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "overall_status": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "host_handoff_allowed": {
            "const": true
          },
          "risk_class": {
            "enum": [
              "read_only",
              "state_change",
              "destructive",
              "network",
              "credential_sensitive",
              "financial",
              "account_change"
            ]
          },
          "effects": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:@/+\\-]{1,200}$"
            }
          },
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:@/+\\-]{1,200}$"
            }
          },
          "required_host_actions": {
            "const": [
              "execute_outside_ainir_core",
              "preserve_assessment_for_audit",
              "resolve_resource_identity_and_scope_at_execution",
              "revalidate_authorization_at_execution"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "overall_status": {
            "const": "review_required"
          }
        }
      },
      "then": {
        "properties": {
          "host_handoff_allowed": {
            "const": false
          },
          "risk_class": {
            "enum": [
              "read_only",
              "state_change",
              "destructive",
              "network",
              "credential_sensitive",
              "financial",
              "account_change"
            ]
          },
          "effects": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:@/+\\-]{1,200}$"
            }
          },
          "capabilities": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:@/+\\-]{1,200}$"
            }
          },
          "required_host_actions": {
            "const": [
              "do_not_execute",
              "obtain_final_destructive_action_confirmation",
              "preserve_assessment_for_audit",
              "reassess_after_final_confirmation"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "overall_status": {
            "enum": [
              "refused",
              "invalid"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "host_handoff_allowed": {
            "const": false
          },
          "required_host_actions": {
            "const": [
              "do_not_execute",
              "preserve_assessment_for_audit",
              "review_failed_checks"
            ]
          }
        }
      }
    }
  ]
}
