{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ainir.dev/schemas/evidence_validation_report.schema.json",
  "title": "AiNIR EvidenceValidationReport v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "version",
    "validation_report_id",
    "validation_report_sha256",
    "overall_status",
    "accepted",
    "candidate_evidence_status",
    "request_id",
    "resolution_id",
    "evidence_id",
    "provider_id",
    "provider_policy_sha256",
    "record_sha256",
    "bundle_sha256",
    "signature_status",
    "checks",
    "trust_gate_promotion_allowed",
    "production_runtime_ready"
  ],
  "properties": {
    "kind": {
      "const": "AiNIREvidenceValidationReport"
    },
    "version": {
      "const": "ainir.evidence-validation-report.v1"
    },
    "validation_report_id": {
      "type": "string",
      "pattern": "^ainir\\.evidence\\.validation\\.[0-9a-f]{20}$"
    },
    "validation_report_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "overall_status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "accepted": {
      "type": "boolean"
    },
    "candidate_evidence_status": {
      "enum": [
        "validated_candidate",
        "refused_candidate"
      ]
    },
    "request_id": {
      "type": "string",
      "pattern": "^ainir\\.evidence\\.request\\.[0-9a-f]{20}$"
    },
    "resolution_id": {
      "type": "string",
      "pattern": "^ainir\\.evidence\\.resolution\\.[0-9a-f]{20}$"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:@/-]{1,160}$"
    },
    "provider_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:@/-]{1,160}$"
    },
    "provider_policy_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "record_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bundle_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signature_status": {
      "enum": [
        "not_applicable",
        "not_present",
        "unverified",
        "verified",
        "failed",
        "unknown_key"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "check",
          "status",
          "expected",
          "actual"
        ],
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "trust_gate_promotion_allowed": {
      "const": false
    },
    "production_runtime_ready": {
      "const": false
    }
  }
}
