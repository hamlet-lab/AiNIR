{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AiNIR TrustReceipt Replay Report",
  "type": "object",
  "required": [
    "overall_status",
    "receipt_id",
    "checks"
  ],
  "properties": {
    "overall_status": {
      "type": "string",
      "enum": [
        "passed",
        "failed"
      ]
    },
    "receipt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check",
          "status"
        ],
        "properties": {
          "check": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed"
            ]
          },
          "expected": {},
          "actual": {}
        }
      }
    },
    "fresh_decision": {
      "type": "object"
    },
    "receipt": {
      "type": "object"
    },
    "kind": {
      "const": "AiNIRTrustReceiptReplayReport"
    },
    "version": {
      "const": "ainir.trust-receipt-replay-report.v1"
    },
    "replay_mode": {
      "enum": [
        "exact_snapshot_replay",
        "current_registry_replay",
        "migrated_registry_replay"
      ]
    },
    "historical_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "passed",
        "refused",
        "invalid",
        null
      ]
    },
    "evaluated_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "passed",
        "refused",
        "invalid",
        null
      ]
    },
    "historical_registry_snapshot_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evaluated_registry_snapshot_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decision_changed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "historical_receipt_unchanged": {
      "type": "boolean"
    },
    "registry_diff_status": {
      "enum": [
        "not_applicable",
        "unavailable",
        "identity_by_bound_hash",
        "available",
        "failed"
      ]
    },
    "registry_diff": {
      "type": [
        "object",
        "null"
      ]
    },
    "migration": {
      "type": [
        "object",
        "null"
      ]
    },
    "production_runtime_ready": {
      "const": false
    }
  },
  "description": "Public exact/current/migrated replay reports. Earlier RC2 reports without replay_mode remain structurally readable; newly generated public reports include the P4 fields.",
  "allOf": [
    {
      "if": {
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "version"
        ]
      }
    },
    {
      "if": {
        "required": [
          "version"
        ]
      },
      "then": {
        "required": [
          "kind"
        ]
      }
    },
    {
      "if": {
        "required": [
          "replay_mode"
        ]
      },
      "then": {
        "required": [
          "historical_status",
          "evaluated_status",
          "historical_registry_snapshot_hash",
          "evaluated_registry_snapshot_hash",
          "decision_changed",
          "historical_receipt_unchanged",
          "registry_diff_status",
          "registry_diff",
          "migration",
          "production_runtime_ready"
        ]
      }
    },
    {
      "if": {
        "required": [
          "replay_mode"
        ]
      },
      "then": {
        "required": [
          "kind",
          "version",
          "historical_status",
          "evaluated_status",
          "historical_registry_snapshot_hash",
          "evaluated_registry_snapshot_hash",
          "decision_changed",
          "historical_receipt_unchanged",
          "registry_diff_status",
          "registry_diff",
          "migration",
          "production_runtime_ready"
        ]
      }
    }
  ],
  "additionalProperties": false
}
